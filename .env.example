# ============================================================================
# REQUIRED — You need these to run the app locally
# ============================================================================

# PostgreSQL connection
# Option A: Use Docker Compose (npm run setup does this automatically)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/poligraph"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/poligraph"

# Option B: Use Supabase or external PostgreSQL
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
# DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# TLS is ON by default. Set to the exact string "false" only for a local,
# non-TLS Postgres such as the disposable Docker test database.
# DATABASE_SSL="false"

# Site URL (used for robots.txt, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Admin authentication (used for /admin dashboard)
ADMIN_PASSWORD="your-secure-admin-password"
# Independent stateless-session configuration. Generate the secret with: openssl rand -base64 48
ADMIN_SESSION_SECRET=""
ADMIN_SESSION_KEY_ID="local-v1"
ADMIN_SESSION_EPOCH="1"
# Set all three only during a bounded key transition. The cutoff is an ISO 8601 instant.
# ADMIN_SESSION_PREVIOUS_SECRET=""
# ADMIN_SESSION_PREVIOUS_KEY_ID=""
# ADMIN_SESSION_PREVIOUS_ISSUED_BEFORE="2026-01-01T00:00:00.000Z"

# ============================================================================
# OPTIONAL — Features that work without these, but are enhanced with them
# ============================================================================

# --- AI / LLM (chatbot, biography generation, tweet generation) ---
ANTHROPIC_API_KEY=""
MISTRAL_API_KEY=""
VOYAGE_API_KEY=""

# --- Google Fact Check Tools API (fact-check sync) ---
GOOGLE_FACTCHECK_API_KEY=""

# --- Inngest — async job queue (scheduled sync, social posting) ---
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# --- Social auto-post (Twitter/Bluesky via Inngest) ---
SOCIAL_AUTO_POST=false
SLACK_SOCIAL_WEBHOOK_URL=""
# Twitter/X OAuth 1.0a. All four are required to post; leave empty to skip Twitter.
TWITTER_API_KEY=""
TWITTER_API_SECRET=""
TWITTER_ACCESS_TOKEN=""
TWITTER_ACCESS_TOKEN_SECRET=""
# Account handle, without the leading "@" (used to build post URLs).
TWITTER_HANDLE=""
# Bluesky. The password is an app password, never the account password.
BLUESKY_HANDLE=""
BLUESKY_APP_PASSWORD=""

# --- Newsletter (Mailjet — weekly email digest) ---
NEWSLETTER_ENABLED=false
MAILJET_API_KEY=""
MAILJET_SECRET_KEY=""
MAILJET_LIST_ID=""
# From: header on every outgoing email. The address must be validated in Mailjet.
MAILJET_SENDER_EMAIL=""
MAILJET_SENDER_NAME=""
# Shared secret used to authenticate Mailjet delivery callbacks
# on /api/newsletter/webhook. Without it the webhook rejects every call.
MAILJET_WEBHOOK_SECRET=""
# Set to the exact string "true" to render and log the newsletter without sending it.
NEWSLETTER_DRY_RUN="false"
# When set, the send goes to this single address instead of the list.
NEWSLETTER_TEST_EMAIL=""

# --- Analytics (Umami — privacy-first, no cookies) ---
NEXT_PUBLIC_UMAMI_URL=""
NEXT_PUBLIC_UMAMI_WEBSITE_ID=""

# --- Error monitoring (Sentry) ---
# Disabled unless NEXT_PUBLIC_SENTRY_ENABLED is the exact string "true".
NEXT_PUBLIC_SENTRY_ENABLED="false"
# Server-side DSN (instrumentation.ts).
SENTRY_DSN=""
# Browser DSN (instrumentation-client.ts). Public by design: a DSN is a write-only
# ingestion endpoint, not a credential.
NEXT_PUBLIC_SENTRY_DSN=""

# ============================================================================
# ADVANCED — Only needed for specific sync scripts
# ============================================================================

# Cron job authentication (for GitHub Actions scheduled triggers)
CRON_SECRET=""

# Admin webhook (Slack notifications for admin actions)
ADMIN_WEBHOOK_URL=""

# Rate limiting (required by the admin login in production)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Optional global caps for paid presidential-search embeddings. Defaults: 5,000/day, 100,000/30d.
PRESIDENTIAL_SEARCH_DAILY_EMBEDDING_LIMIT="5000"
PRESIDENTIAL_SEARCH_MONTHLY_EMBEDDING_LIMIT="100000"
# Set automatically by the Vercel/Upstash integration. When present these win over
# the two manual aliases above, because the integration rotates them.
# POLIGRAPH_API_KV_REST_API_URL=""
# POLIGRAPH_API_KV_REST_API_TOKEN=""

# Judilibre API (Cour de cassation — judicial decisions sync)
JUDILIBRE_CLIENT_ID=""
JUDILIBRE_CLIENT_SECRET=""
JUDILIBRE_API_KEY=""
JUDILIBRE_BASE_URL="https://api.piste.gouv.fr/cassation/judilibre/v1.0"
JUDILIBRE_OAUTH_URL="https://oauth.piste.gouv.fr/api/oauth/token"

# --- Other external sources ---
# Brave Search (affair discovery, moderation research).
BRAVE_API_KEY=""
# OpenSanctions (politically exposed persons sync).
OPENSANCTIONS_API_KEY=""
# GitHub REST API for the platform-updates sync. Optional: without it the call is
# anonymous and subject to a much lower rate limit.
GITHUB_TOKEN=""
# IndexNow key (UUID) used to notify search engines of fresh URLs.
# Unset means the submission is skipped, not that it fails.
INDEXNOW_KEY=""

# --- Operational scripts and diagnostics ---
# notify-press-backlog: alert recipient and the queue size that triggers the alert.
PRESS_BACKLOG_NOTIFY_EMAIL=""
# PRESS_BACKLOG_THRESHOLD="50"
# Daily pipeline digest recipient.
PIPELINE_DIGEST_EMAIL=""
# check-amendment-link-freshness thresholds. Defaults: 48 hours, legislature 17,
# 20 unlinked amendments.
# LINK_FRESHNESS_MAX_LAG_HOURS="48"
# LINK_FRESHNESS_LEGISLATURE="17"
# LINK_FRESHNESS_ABS_UNLINKED="20"
# Target host for the production smoke run and for the chatbot test harness.
# SMOKE_BASE_URL="https://poligraph.fr"
# TEST_BASE_URL="http://localhost:3000"
# reconcile-municipales-2026-mayors: path to the input CSV.
# RECONCILE_CSV=""
# check-build-network: path to the network log captured during the build.
# Required by `npm run build:net-check`, which exits 1 without it.
# BUILD_NET_LOG=""

# Seed safety: comma-separated DB host patterns to block from seeding
SEED_BLOCKED_HOSTS=""
