  status      CandidacyStatus?
  sourceUrl   String?
  sourceLabel String?

  // Candidate entity (lightweight, for local elections)
  candidate   Candidate? @relation(fields: [candidateId], references: [id])
  candidateId String?

  // Commune (for municipal elections)
  commune   Commune? @relation(fields: [communeId], references: [id])
  communeId String?

  // List elections (municipales, européennes, régionales)
  listName     String?
  listPosition Int?

  // Electoral list entity (replaces in-memory groupBy on listName)
  electoralList   ElectoralList? @relation(fields: [electoralListId], references: [id])
  electoralListId String?

  // Constituency
  constituencyCode String?
  constituencyName String?

