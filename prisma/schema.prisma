  verifiedAt      DateTime?
  verifiedBy      String?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([politicianId])
  @@index([theme])
  @@index([publishedAt])
  @@index([extractionStatus, publishedAt])
}

// ============================================
// PROGRAMMES & QUIZ (boussole politique)
// ============================================

model Platform {
  id              String         @id @default(cuid())
  party           Party?         @relation(fields: [partyId], references: [id])
  partyId         String?
  electoralList   ElectoralList? @relation(fields: [electoralListId], references: [id])
  electoralListId String?        @unique
  election        Election       @relation(fields: [electionId], references: [id])
  electionId      String

  sourceUrl         String?
  publicationStatus PublicationStatus @default(DRAFT)

  proposals Proposal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([partyId, electionId])
  @@index([partyId])
  @@index([electionId])
  @@index([publicationStatus])
  @@index([electionId, publicationStatus])
}

model Proposal {
  id         String   @id @default(cuid())
  platform   Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)
  platformId String

  axis     ThematicAxis
  position Int // -3..+3 scale: negative = Pole A, 0 = neutral, positive = Pole B

  summary       String
  sourceExcerpt String? @db.Text
  sourceUrl     String?

  aiGenerated Boolean @default(false)
  verifiedBy  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([platformId, axis])
  @@index([platformId])
  @@index([axis])
}

model QuizQuestion {
  id    String            @id @default(cuid())
  axis  ThematicAxis
  scope QuizElectionScope

  statement String
  order     Int

  publicationStatus PublicationStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([axis, scope])
  @@index([publicationStatus, scope])
}

model ProfessionDeFoi {
  id              String        @id @default(cuid())
  electoralList   ElectoralList @relation(fields: [electoralListId], references: [id], onDelete: Cascade)
  electoralListId String        @unique

  pdfUrl   String
  falcUrl  String?
  audioUrl String?
  source   ProfessionDeFoiSource @default(MINISTERE_INTERIEUR)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// PUBLIC ID REDIRECTS (poligraphId infrastructure)
// ============================================
// When entities are merged or deprecated, the old publicId must keep resolving
// to the canonical entity so that external citations (research papers, Wikidata,
// etc.) never break. Write one row here per merge/deprecation event.
// See /docs/api (section "poligraphId") for the full specification.
model PublicIdRedirect {
  fromPublicId String   @id // "AF-000542" — the retired identifier
  toPublicId   String // "AF-000789" — the canonical identifier it now points to
  entityType   String // "affair" | "politician" | "factcheck" | "scrutin" | "party" | "election" | "mandate" | "dossier" | "group" | "electoralList"
  reason       String // "merged" | "deprecated" | "corrected" — free text for the audit trail
  createdAt    DateTime @default(now())

  @@index([toPublicId])
  @@index([entityType])
}

/// Human ruling on a detected duplicate pair (issue #525).
///
/// Detection now covers published affairs, so the same queue holds pairs that a
/// cron may fold and pairs that need a person. This records what that person
/// decided, so the pair stops coming back.
///
/// Affair references are deliberately plain strings with no relation: a DUPLICATE
/// ruling must outlive the row it absorbed, and a Cascade or Restrict would either
/// erase the ruling or block the merge it authorised.
model AffairPairDecision {
  id String @id @default(cuid())

  /// Sorted "idA:idB". The single guard against (A,B) and (B,A) both being stored.
  pairKey   String @unique
  affairIdA String
  affairIdB String

  classification AffairPairClassification

  /// Why the pair was proposed, kept so a ruling can be re-read in context.
  confidence String
  matchedBy  String
  score      Float

  /// Both rows as of the ruling. A later edit on either side makes a DISTINCT or
  /// UNCERTAIN ruling stale, and the pair may be proposed again.
  affairAUpdatedAt DateTime
  affairBUpdatedAt DateTime

  /// Survivor of a merge authorised by a DUPLICATE ruling.
  mergedIntoAffairId String?

  reviewedBy String
  reviewedAt DateTime @default(now())
  notes      String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classification, reviewedAt])
  @@index([affairIdA])
  @@index([affairIdB])
}

enum AffairPairClassification {
  /// One affair recorded twice: merge authorised.
  DUPLICATE

  /// Distinct affairs that belong to the same story. Publishing the link is a
  /// separate editorial act, never a side effect of this ruling.
  LINKED

  /// Not the same affair. Excluded until either row changes.
  DISTINCT

  /// Deferred, not an exclusion: stays visible in a re-examination filter.
  UNCERTAIN
}

/// Une décision juridictionnelle rendue par une juridiction identifiée, quel que
/// soit son ordre ou sa matière (#536).
///
/// Existe parce qu'une décision peut concerner plusieurs fiches éditoriales : deux
/// condamnations mesurées en base partagent un numéro de pourvoi, une date de faits,
/// une date de verdict et un arrêt de cassation, et sont pourtant deux chefs
/// distincts. `Affair.ecli @unique` rend ce cas inexprimable.
///
/// Ne représente PAS un acte d'une autorité non juridictionnelle : ni réquisition du
/// ministère public, ni délibération de la HATVP, ni sanction du Bureau du Sénat, ni
/// travaux d'une commission d'enquête. Voir docs/judicial-decision-model.md §4 bis.
model CourtDecision {
  id String @id @default(cuid())

  /// Clé externe Judilibre. Avec `ecli`, la seule identité réutilisable
  /// automatiquement : le reste exige une procédure contrôlée.
  judilibreId String? @unique
  /// Identifiant européen. Identifie exactement une décision, d'où l'unicité — et
  /// c'est ici son domicile correct, pas sur `Affair`.
  ecli        String? @unique

  /// Tel que publié, pour l'affichage : « 96-83.698 ».
  pourvoiNumber           String?
  /// Sans séparateurs, pour le rapprochement : « 9683698 ».
  /// Indexé mais NON unique : un même pourvoi peut produire plusieurs décisions
  /// (rejet, cassation partielle, renvoi), et rien dans les données ne prouve le
  /// contraire. Ne jamais dédupliquer automatiquement sur ce champ.
  pourvoiNumberNormalized String?

  decisionDate DateTime?
  /// La juridiction émettrice, jamais un parquet. Renseigné uniquement depuis une
  /// source officielle : 23,7 % des `Affair.court` désignent un organe non
  /// juridictionnel, donc ce champ ne se recopie pas depuis l'affaire.
  court        String?
  chamber      String?
  /// Sens de la décision : rejet, cassation, cassation partielle, non-admission.
  /// Chaîne libre en attendant d'observer le vocabulaire réel de Judilibre.
  solution     String?
  /// URL officielle canonique.
  sourceUrl    String?

  /// Charge brute d'une source officielle. Non requêtable, non faisant foi, et
  /// jamais un endroit où ranger un champ modélisable.
  metadata Json?

  affairs AffairCourtDecision[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pourvoiNumberNormalized])
  @@index([decisionDate])
}

/// Rattachement d'une fiche éditoriale à une décision. Plusieurs-à-plusieurs des
/// deux côtés : une décision peut porter plusieurs chefs, et une affaire peut
/// traverser plusieurs décisions (#536).
///
/// Pas d'enum de relation : un seul cas réel observé ne peut pas en justifier cinq
/// valeurs, dont certaines relèvent de #516 ou décrivent une relation entre deux
/// décisions plutôt qu'entre une décision et une affaire.
model AffairCourtDecision {
  affairId        String
  courtDecisionId String

  /// Ce qu'un relecteur constate, en attendant assez de cas pour un enum honnête.
  notes String?

  affair        Affair        @relation(fields: [affairId], references: [id], onDelete: Cascade)
  courtDecision CourtDecision @relation(fields: [courtDecisionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([affairId, courtDecisionId])
  @@index([courtDecisionId])
}

// ============================================
// SEARCH SUBSTRATE (lot 1B)
// ============================================

enum SearchEntityType {
  MEASURE
  QUESTION
  CANDIDACY
}

enum SearchVisibility {
  PUBLIC
  ADMIN_ONLY
}

// Central inverted index. Deliberately agnostic of the entity it describes:
// entityType + entityId and no foreign key, so a single write path serves the
// measures of lot 1, the questions of lot 6 and the six existing entity families
// that lot 9 will migrate.
model SearchDocument {
  id String @id @default(cuid())

  entityType SearchEntityType
  entityId   String

  title String
  body  String @db.Text
  url   String // result destination, so a search never needs a second query

  visibility SearchVisibility

  // Optional election scope. Questions and future global entities remain null; election-bound
  // documents must set it explicitly through upsertSearchDocument(). Deliberately no relation:
  // the central index stays entity-agnostic and search:audit owns orphan detection.
  electionId String?

  // Opaque identifier, deliberately NOT a relation: Question has its own revision
  // family and the lot 9 entities have no revision at all. Nothing guarantees this
  // value points at an existing row, which is what `search:audit` is for.
  sourceRevisionId String?

  // Filled by SQL in upsertSearchDocument(). Prisma cannot read this type; only the
  // GIN index uses it. Must stay nullable: a non-nullable Unsupported column makes
  // some write operations disappear from the generated client.
  //
  // The only derived column, and deliberately so. An accent-folded text column with a
  // GIN trigram index used to sit next to it for a substring fallback, which turned out
  // to recover the plural we want (loyer -> loyers) and the false positive we refuse
  // (retrait -> retraite) with no way to tell them apart. searchPublic() enumerates
  // controlled variants against this vector instead. Approximate search is lot 7's
  // subject: it measures its own operators and thresholds against a negative corpus, so
  // it declares its own columns rather than inheriting a guess made here. title and body
  // stay on the row, so any derived column can be rebuilt when the need is demonstrated.
  searchVector Unsupported("tsvector")?

  indexedAt       DateTime @default(now())
  sourceUpdatedAt DateTime // the reference revision's updatedAt at indexing time

  semanticEmbedding SearchEmbedding?

  @@unique([entityType, entityId])
  @@index([searchVector], type: Gin)
  @@index([visibility])
  @@index([electionId, visibility])
}

// Semantic vector derived from one SearchDocument. It is deliberately separate from the
// historical ChatEmbedding RAG table: public election search has stricter visibility, freshness
// and provider-version requirements. Prisma cannot read or write the vector itself, so the
// embedding service owns that column through parameterized SQL.
model SearchEmbedding {
  id String @id @default(cuid())

  searchDocumentId String         @unique
  searchDocument   SearchDocument @relation(fields: [searchDocumentId], references: [id], onDelete: Cascade)

  model           String
  dimensions      Int
  contentHash     String
  sourceUpdatedAt DateTime
  embedding       Unsupported("extensions.vector(1024)")

  embeddedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([model, sourceUpdatedAt])
}

// ============================================
// MEASURES : versioned editorial model (lot 1)
// ============================================

enum MeasureAttribution {
  PERSONAL // the person formulated the measure themselves
  PARTY_PROGRAM // inherited from the party programme, not personally stated
}

enum MeasurePrecision {
  CHIFFREE
  OBJECTIF_SANS_CHIFFRE
}

// How the text entered the database. No provider name here: the provider changes
// (this repo already has a Mistral fallback on theme classification), so the fine
// detail lives in MeasureRevision.extractorVersion, which is free text.
enum MeasureExtractionMethod {
  MANUAL
  AI_ASSISTED
  IMPORTED
}

// Technical state of an imported revision before any editorial decision. A READY revision is
// ready to be read, not validated or publishable. TECHNICALLY_BLOCKED never reaches persistence.
enum MeasureReviewReadiness {
  READY_FOR_REVIEW
  REVIEW_WITH_WARNING
}

enum MeasureReviewWarning {
  POSSIBLE_DIAGNOSIS_AS_ACTION
  POSSIBLE_EXISTING_POLICY
  ATTRIBUTION_UNCERTAIN
  POSSIBLE_DUPLICATE
  OBJECTIVE_VS_MEASURE_UNCERTAIN
  WORDING_NEEDS_REVIEW
  EVIDENCE_SCOPE_WEAK
  MODEL_LOW_CONFIDENCE
}

enum MeasureRejectionReason {
  NOT_A_PROPOSAL
  DIAGNOSIS_ONLY
  THIRD_PARTY
  EXISTING_POLICY
  HISTORICAL
  DUPLICATE
  INSUFFICIENT_EVIDENCE
  BAD_WORDING
  OTHER
}

// Eight values and not six. A campaign rally, a televised debate and a written
// declaration are the most common primary sources of a presidential measure, and
// revision 3 of the spec could express none of them: a non-parliamentary candidate
// had no primary source at all. Closed on purpose, with no AUTRE value: the 60 %
// primary-source threshold of spec 4.1 stops being auditable if a catch-all bucket
// can carry tier = PRIMARY.
enum MeasureSourceKind {
  PROGRAMME_PARTI
  PROGRAMME_CANDIDAT
  PROPOSITIONS_CANDIDAT
  DISCOURS_CAMPAGNE
  DEBAT_TELEVISE
  DISCOURS_AN
  DISCOURS_SENAT
  INTERVIEW_PRESSE
  ARTICLE_PRESSE
  PROPOSITION_LOI
}

enum SourceTier {
  PRIMARY
  SECONDARY
}

// Every value needs an opposable definition before it can be used, see
// docs/editorial/qualifications-mesures.md.
enum QualificationKind {
  FINANCEMENT_NON_PRECISE
  DEJA_TENTEE
  CALENDRIER_PRECISE
  PERIMETRE_INCERTAIN
}

enum SimilarityConclusion {
  NO_EQUIVALENT_FOUND
  EQUIVALENT_FOUND
  INCONCLUSIVE
}

enum ProgramOwnerType {
  PARTY
  CANDIDACY
}

enum MeasureSubtopicAssignmentStatus {
  SUGGESTED
  APPROVED
  REJECTED
}

// Closed, versioned navigation vocabulary. A subtopic belongs to one broad theme; it is not a
// free-form tag and therefore cannot silently split into synonyms over successive imports.
model MeasureSubtopic {
  id          String        @id @default(cuid())
  slug        String        @unique
  label       String
  description String        @db.Text
  theme       ThemeCategory
  aliases     String[]      @default([])
  active      Boolean       @default(true)
  sortOrder   Int           @default(0)

  assignments MeasureRevisionSubtopic[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([theme, active, sortOrder])
}

// Attached to the revision rather than the stable measure because a rewritten formulation can
// change subject. AI only creates SUGGESTED rows; APPROVED is a human editorial decision.
model MeasureRevisionSubtopic {
  revision   MeasureRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  revisionId String
  subtopic   MeasureSubtopic @relation(fields: [subtopicId], references: [id], onDelete: Restrict)
  subtopicId String

  status            MeasureSubtopicAssignmentStatus @default(SUGGESTED)
  confidence        Float?
  method            String
  classifierVersion String
  taxonomyVersion   String
  proposedAt        DateTime                        @default(now())
  reviewedAt        DateTime?
  reviewedBy        String?

  @@id([revisionId, subtopicId])
  @@index([subtopicId, status])
  @@index([revisionId, status])
}

// The stable object. Two publication pointers, not one: latestRevisionId carries the
// work in progress, publishedRevisionId carries what the public sees. With a single
// pointer, fixing a comma created an unreviewed revision that became current, which
// pulled the measure off the site and could push a subject page under its indexing
// threshold. An internal editorial action would depublish valid public content.
model Measure {
  id   String @id @default(cuid())
  // Stable public URL segment. It is derived once from the carrier and the first formulation,
  // then kept when later revisions change the wording.
  slug String @unique

  politician   Politician @relation(fields: [politicianId], references: [id], onDelete: Cascade)
  politicianId String
  election     Election   @relation(fields: [electionId], references: [id], onDelete: Cascade)
  electionId   String
  candidacy    Candidacy? @relation(fields: [candidacyId], references: [id], onDelete: SetNull)
  candidacyId  String?

  programEdition   ProgramEdition? @relation(fields: [programEditionId], references: [id], onDelete: SetNull)
  programEditionId String?

  attribution MeasureAttribution
  theme       ThemeCategory

  // The same proposal at an earlier election (spec 5.1, case 1).
  precedingMeasure   Measure?  @relation("MeasureLineage", fields: [precedingMeasureId], references: [id], onDelete: SetNull)
  precedingMeasureId String?
  followingMeasures  Measure[] @relation("MeasureLineage")

  revisions MeasureRevision[] @relation("MeasureRevisions")
  voteLinks MeasureVoteLink[] @relation("MeasureVoteLinks")

  latestRevision      MeasureRevision? @relation("MeasureLatest", fields: [latestRevisionId], references: [id], onDelete: SetNull)
  latestRevisionId    String?          @unique
  publishedRevision   MeasureRevision? @relation("MeasurePublished", fields: [publishedRevisionId], references: [id], onDelete: SetNull)
  publishedRevisionId String?          @unique

  // Withdrawal is not a revision: fixing a text produces a new revision, withdrawing
  // a proposal changes the state of the object. Three flat fields rather than an event
  // table because there is only one transition to keep today, written only by
  // withdrawMeasure() and never separately.
  withdrawnAt          DateTime?
  withdrawnSourceUrl   String?
  withdrawnSourceLabel String?

  publicationStatus PublicationStatus @default(DRAFT)

  // "Leaves a trace" of spec 5.10, made concrete: without these two fields a
  // depublication is indistinguishable from a measure that was never published.
  depublishedAt       DateTime?
  depublicationReason String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([electionId, publicationStatus])
  @@index([politicianId])
  @@index([candidacyId])
  @@index([theme, publicationStatus])
  @@index([programEditionId])
}

// What is said, and when. Four dates with four distinct meanings: validFrom is when
// the candidate's formulation applies, publishedAt is when Poligraph validated it,
// supersededAt is when a public version was replaced, discardedAt is when a draft was
// abandoned. Collapsing the first two made the revision 3 invariant impossible to hold.
model MeasureRevision {
  id String @id @default(cuid())

  measure   Measure @relation("MeasureRevisions", fields: [measureId], references: [id], onDelete: Cascade)
  measureId String

  text      String            @db.Text
  // Optional source-backed context edited and reviewed with this exact formulation.
  details   String?           @db.Text
  precision MeasurePrecision?

  validFrom    DateTime
  publishedAt  DateTime?
  supersededAt DateTime?
  discardedAt  DateTime?
  reviewedAt   DateTime?
  reviewedBy   String?

  extractionMethod     MeasureExtractionMethod
  extractionConfidence Float?
  extractorVersion     String?
  evidenceSnapshot     Json?
  importFingerprint    String?                 @unique
  reviewReadiness      MeasureReviewReadiness?
  reviewWarnings       MeasureReviewWarning[]  @default([])

  rejectedAt      DateTime?
  rejectedBy      String?
  rejectionReason MeasureRejectionReason?
  rejectionDetail String?                 @db.Text

  sources             MeasureSource[]
  qualifications      MeasureQualification[]
  assessments         MeasureSimilarityAssessment[]
  equivalentOf        MeasureSimilarityMatch[]      @relation("EquivalentRevision")
  applicableVoteLinks MeasureVoteLink[]             @relation("ApplicableRevisionVoteLinks")
  subtopics           MeasureRevisionSubtopic[]

  latestOf    Measure? @relation("MeasureLatest")
  publishedOf Measure? @relation("MeasurePublished")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([measureId, validFrom])
  @@index([measureId, supersededAt])
  @@index([measureId, discardedAt])
}

enum MeasureVoteLinkKind {
  SAME_OBJECT
  BROADER_TEXT
  NO_VOTE_IDENTIFIED
}

// The candidate's relation to the measure on a scrutin, RECORDED by the reviewer, never derived from
// the raw vote: on a suppression amendment, voting POUR is DEFAVORABLE to the measure. This field is
// beyond the minimal §5.8 table and exists precisely for the polarity trap the spec flags. Manual by
// design (§5.8: the attachment is an editorial judgment made explicit by rationale).
enum MeasureVoteRelation {
  FAVORABLE
  DEFAVORABLE
  ABSTENTION
  ABSENCE
}

// The link between a measure and a scrutin (spec 5.8). Rattached to the Measure, but applicableRevisionId
// records the formulation the link was judged applicable to. Written only in admin, never by a script.
model MeasureVoteLink {
  id String @id @default(cuid())

  measure   Measure @relation("MeasureVoteLinks", fields: [measureId], references: [id], onDelete: Cascade)
  measureId String

  applicableRevision   MeasureRevision @relation("ApplicableRevisionVoteLinks", fields: [applicableRevisionId], references: [id], onDelete: Cascade)
  applicableRevisionId String

  scrutin   Scrutin? @relation(fields: [scrutinId], references: [id], onDelete: SetNull)
  scrutinId String?

  linkKind    MeasureVoteLinkKind
  // Set only on a SAME_OBJECT link tied to a scrutin. Reviewer-recorded, never derived.
  relation    MeasureVoteRelation?
  isReference Boolean              @default(false)

  rationale        String    @db.Text
  checkedAt        DateTime
  institutionScope Chamber[]
  legislatureScope String[]
  searchMethod     String
  reviewedBy       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([measureId])
  @@index([applicableRevisionId])
  @@index([scrutinId])
}

// Attached to the revision and not to the measure: this is what represents the ordinary
// case of a measure announced in an interview, reformulated in the programme, then cited
// by three newspapers.
model MeasureSource {
  id String @id @default(cuid())

  measureRevision   MeasureRevision @relation(fields: [measureRevisionId], references: [id], onDelete: Cascade)
  measureRevisionId String

  sourceKind  MeasureSourceKind
  tier        SourceTier
  url         String
  page        String?
  publishedAt DateTime

  createdAt DateTime @default(now())

  @@index([measureRevisionId])
  @@index([tier])
}

// Qualifiers as dated conclusions and not as a String[] on the measure: "funding not
// specified" is not a technical property, it is an editorial conclusion that depends on
// the text analysed, can go stale, and sometimes needs a source (spec rule 4).
model MeasureQualification {
  id String @id @default(cuid())

  measureRevision   MeasureRevision @relation(fields: [measureRevisionId], references: [id], onDelete: Cascade)
  measureRevisionId String

  kind        QualificationKind
  label       String
  rationale   String            @db.Text
  sourceUrl   String?
  sourceLabel String?
  assessedAt  DateTime
  assessedBy  String

  createdAt DateTime @default(now())

  @@index([measureRevisionId])
}

// Uniqueness as a dated assessment. A boolean isUnique would go stale immediately: a
// measure looks unique until the next programme is published, and "equivalent" has no
// single definition. The assessment targets a revision, since a major reformulation can
// change the result.
model MeasureSimilarityAssessment {
  id String @id @default(cuid())

  measureRevision   MeasureRevision @relation(fields: [measureRevisionId], references: [id], onDelete: Cascade)
  measureRevisionId String

  comparedCorpusVersion String
  assessedAt            DateTime
  assessedBy            String
  conclusion            SimilarityConclusion
  rationale             String               @db.Text

  matches MeasureSimilarityMatch[]

  createdAt DateTime @default(now())

  @@index([measureRevisionId])
}

// An EQUIVALENT_FOUND conclusion without the identified equivalents is neither usable
// nor auditable, so the matches are rows and not a sentence in the rationale.
model MeasureSimilarityMatch {
  id String @id @default(cuid())

  assessment   MeasureSimilarityAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  assessmentId String

  equivalentMeasureRevision   MeasureRevision @relation("EquivalentRevision", fields: [equivalentMeasureRevisionId], references: [id], onDelete: Cascade)
  equivalentMeasureRevisionId String

  createdAt DateTime @default(now())

  @@unique([assessmentId, equivalentMeasureRevisionId])
  @@index([equivalentMeasureRevisionId])
}

// Platform cannot play this role: it carries @@unique([partyId, electionId]), which
// forbids several editions per campaign, and it is semantically loaded by the compass
// (its Proposal rows are a -3..+3 position on 8 axes) and lives in production.
model ProgramEdition {
  id String @id @default(cuid())

  election   Election @relation(fields: [electionId], references: [id], onDelete: Cascade)
  electionId String

  // An explicit owner rather than an implicit invariant: ownerType says which of the
  // two fields is set, and the validation guarantees exactly one, not at least one.
  ownerType   ProgramOwnerType
  party       Party?           @relation(fields: [partyId], references: [id], onDelete: Cascade)
  partyId     String?
  candidacy   Candidacy?       @relation(fields: [candidacyId], references: [id], onDelete: Cascade)
  candidacyId String?

  label       String
  version     Int
  publishedAt DateTime
  documentUrl String

  publicationStatus PublicationStatus @default(DRAFT)

  measures Measure[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Two separate constraints, never one composite. In PostgreSQL the NULLs of a unique
  // index are distinct, so a composite including both owners would let two identical
  // PARTY editions through, each with candidacyId NULL. Each constraint below only
  // bites on the rows where its owner column is set.
  @@unique([partyId, electionId, version])
  @@unique([candidacyId, electionId, version])
  @@index([electionId, publicationStatus])
}
