// ============================================
// PRE-COMPUTED STATS
// ============================================

/// Per-politician participation stats, pre-computed by sync:compute-stats.
/// Enables instant pagination/ranking without expensive CTE+LATERAL queries.
model PoliticianParticipation {
  id           String     @id @default(cuid())
  politicianId String
  politician   Politician @relation(fields: [politicianId], references: [id], onDelete: Cascade)

  // Core stats
  chamber            Chamber // AN or SENAT (derived from mandate type)
  mandateType        String // "DEPUTE" or "SENATEUR"
  votesCount         Int
  eligibleScrutins   Int
  participationRate  Float // 0-100, pre-computed
  computationVersion String?

  // Denormalized display fields (avoid JOINs in read queries)
  firstName      String
  lastName       String
  slug           String
  photoUrl       String?
  partyId        String?
  partyShortName String?
  partyColor     String?
  partySlug      String?
  groupId        String?
  groupCode      String?
  groupName      String?
  groupColor     String?

  // Dissidence stats (null = no group or insufficient data)
  dissidenceRate  Float? // 0-100, % of votes against group majority
  dissidenceCount Int? // Number of dissident votes
  dissidenceTotal Int? // Total votes with group majority available

  // Thematic vote distribution (JSON blob)
  // Shape: { "ECONOMIE_BUDGET": { pour: 12, contre: 3, abstention: 1, total: 16 }, ... }
  themeDistribution Json?

  computedAt DateTime @default(now())

  @@unique([politicianId]) // One row per politician
  @@index([chamber, participationRate]) // Fast filtered+sorted pagination
  @@index([participationRate]) // Fast global ranking
  @@index([chamber, dissidenceRate]) // Fast dissidence ranking
}

/// Key-value store for aggregate stats (party/group participation, etc.).
/// Pre-computed by sync:compute-stats, read as JSON blobs by the stats page.
model StatsSnapshot {
  id         String   @id @default(cuid())
  key        String   @unique // e.g. "party-participation", "group-participation-AN"
  data       Json // The pre-computed result array/object
  computedAt DateTime @default(now())
  durationMs Int      @default(0) // How long the computation took
}

